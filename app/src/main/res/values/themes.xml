<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Edit these to change the neon look. -->
    <color name="vs_background">#07060F</color>
    <color name="vs_neon_cyan">#00F0FF</color>
    <color name="vs_neon_pink">#FF2BD6</color>

    <style name="Theme.VibeSync" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/vs_neon_pink</item>
        <item name="android:colorAccent">@color/vs_neon_cyan</item>
        <item name="android:windowBackground">@color/vs_background</item>
        <!-- neon cyan status bar with dark icons -->
        <item name="android:statusBarColor">@color/vs_neon_cyan</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/vs_background</item>
    </style>
</resources>
