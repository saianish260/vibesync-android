<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Midnight theme, matching the web app. Edit these to restyle. -->
    <color name="vs_background">#0B0D17</color>
    <color name="vs_accent">#7C5CFF</color>
    <color name="vs_accent_2">#22D3EE</color>

    <style name="Theme.VibeSync" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/vs_accent</item>
        <item name="android:colorAccent">@color/vs_accent_2</item>
        <item name="android:windowBackground">@color/vs_background</item>
        <item name="android:statusBarColor">@color/vs_background</item>
        <item name="android:navigationBarColor">@color/vs_background</item>
    </style>
</resources>
