<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- new-episode reminders: show the notification, and re-arm reminders after the phone restarts -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- in-app updates: lets VibeSync hand its own new version to Android's installer (you confirm it) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Android 11+: lets VibeSync check whether these OTT apps are installed (no permission needed) -->
    <queries>
        <package android:name="com.netflix.mediaclient" />
        <package android:name="com.amazon.avod.thirdpartyclient" />
        <package android:name="in.startv.hotstar" />
        <package android:name="com.crunchyroll.crunchyroid" />
        <package android:name="com.sonyliv" />
        <package android:name="com.graymatrix.did" />
        <package android:name="com.dream11sportsguru" />
        <package android:name="ahaflix.tv" />
        <package android:name="com.apple.atve.androidtv.appletv" />
        <package android:name="com.google.android.youtube" />
        <package android:name="com.suntv.sunnxt" />
        <package android:name="com.bt.bms" />
        <package android:name="com.application.zomato.district" />
        <package android:name="com.net.pvr" />
        <package android:name="com.android.vending" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:label="VibeSync"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.VibeSync"
        android:allowBackup="true"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver android:name=".ReminderReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver android:name=".PickWidget" android:exported="false" android:label="VibeSync · Tonight's pick">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_pick_info" />
        </receiver>
        <receiver android:name=".UpdateReceiver" android:exported="false" />
    </application>
</manifest>
